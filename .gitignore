# --- Secrets / local env ---
*.crt
*.key
*.pem
.env
.env.*
!.env.example
secrets/

# --- Runtime checkpoint state (bind-mounted into the container) ---
state/*
!state/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml
dist/
build/

# uv: lockfile IS committed (reproducible builds), caches are not
.uv/

# --- Superpowers scratch: NEVER commit specs/plans (operating-model HARD RULE) ---
docs/superpowers/

# --- Local working notes / scratch (not deliverables) ---
ko.md

# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/

# Zensical build output. The m7kni.io hub builds this repo's docs from
# docs/ plus docs.toml; nothing here ever needs a built site committed.
/site

# Injected by the m7kni.io hub at build time — never commit these.
# The hub copies its own SEO template, brand stylesheet and fonts into a clone
# and generates zensical.toml from docs.toml. A tracked copy here is drift, and
# is exactly what the manifest model exists to prevent.
/zensical.toml
docs/overrides/
docs/stylesheets/brand.css
docs/assets/project-icon.svg
docs/assets/project-icon-solid.svg
docs/assets/social-card.png
docs/assets/social-card.svg
docs/fonts/

# Track only the Claude Code settings and the hooks, which exist to mechanically
.claude/
